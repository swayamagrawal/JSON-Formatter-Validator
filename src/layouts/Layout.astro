---
// src/layouts/Layout.astro
import "../styles/global.css";
import Header from "../components/ui/Header.astro";
import Footer from "../components/ui/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  canonical?: string;
  noIndex?: boolean;
}

const {
  title = "QuietJSON — Free JSON Formatter, Validator & Repair Tool",
  description = "Format, validate, minify and auto-repair JSON instantly. 100% free, 100% client-side — your data never leaves your browser.",
  ogTitle = title,
  ogDescription = description,
  canonical = Astro.url.href,
  noIndex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GWLLY4YJ7H"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-GWLLY4YJ7H');
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="QuietJSON" />
    <meta property="og:image" content="https://quietjson.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="QuietJSON — Free, Private JSON Tools" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content="https://quietjson.com/og-image.png" />

    <!-- Multi-Device Favicons & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="QuietJSON" />
    <meta name="theme-color" content="#0d0d0d" />

    <!-- Fonts: Inter + JetBrains Mono from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <!-- Prevent flash of wrong theme — must run before body renders -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem("jsoncraft-theme");
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var theme = stored === "light" || stored === "dark" ? stored : (prefersDark ? "dark" : "light");
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>

    <!-- llms.txt discovery for AI engines (ChatGPT, Perplexity, Claude, Gemini) -->
    <link rel="ai-content-info" href="https://quietjson.com/llms.txt" />

    <!-- geo-fix-schema: Organization schema — AI entity recognition & brand knowledge graph -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "QuietJSON",
      "url": "https://quietjson.com",
      "logo": "https://quietjson.com/favicon-96x96.png",
      "description": "QuietJSON is a free, 100% client-side JSON toolkit for developers. It formats, validates, minifies, auto-repairs, converts, and diffs JSON data entirely inside the browser — no data is ever uploaded to a server.",
      "foundingDate": "2026",
      "sameAs": [
        "https://github.com/swayamagrawal/JSON-Formatter-Validator"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": "hello@quietjson.com",
        "url": "https://quietjson.com/contact"
      }
    }
    </script>

    <!-- geo-fix-schema: WebSite schema — sitelinks & AI site identity -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "QuietJSON",
      "url": "https://quietjson.com",
      "description": "Free online JSON formatter, validator, repair, converter, and diff tools. 100% client-side, zero data upload.",
      "inLanguage": "en",
      "publisher": {
        "@type": "Organization",
        "name": "QuietJSON",
        "url": "https://quietjson.com"
      }
    }
    </script>

    <!-- geo-fix-schema: SoftwareApplication — AI product/tool recognition -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "QuietJSON",
      "url": "https://quietjson.com",
      "applicationCategory": "DeveloperApplication",
      "applicationSubCategory": "JSON Tools",
      "operatingSystem": "All — runs in any modern web browser",
      "description": "QuietJSON is a free, private JSON toolkit that formats, validates, minifies, auto-repairs, converts (JSON to CSV, JSON to YAML), and diffs JSON data. All processing is 100% client-side — no data leaves the browser.",
      "featureList": [
        "JSON Formatter with 2-space, 4-space, and tab indentation",
        "Real-time JSON validator with error line numbers",
        "AI JSON repair — fixes ChatGPT, Claude, Gemini output errors",
        "Interactive Tree View for nested JSON exploration",
        "JSON minifier for production payloads",
        "JSON to CSV converter with dot-notation key flattening",
        "JSON to YAML converter (bi-directional)",
        "JSON diff tool with JSONPath change tracking",
        "File upload and download support",
        "Zero server uploads — 100% client-side processing"
      ],
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock"
      },
      "softwareVersion": "1.0",
      "datePublished": "2026-08-22",
      "inLanguage": "en",
      "isAccessibleForFree": true,
      "provider": {
        "@type": "Organization",
        "name": "QuietJSON",
        "url": "https://quietjson.com"
      }
    }
    </script>

    <!-- Named slot: pages can inject JSON-LD, extra meta, etc. -->
    <slot name="head" />
  </head>

  <body>
    <Header />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
