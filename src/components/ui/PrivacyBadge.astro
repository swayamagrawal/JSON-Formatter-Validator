---
// src/components/ui/PrivacyBadge.astro
---

<div
  role="status"
  aria-label="Privacy guarantee"
  style="
    background-color: var(--color-canvas-soft-2);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-sm);
    padding: 10px 16px;
  "
  class="flex items-center justify-center gap-2 text-center"
>
  <!-- Lock icon -->
  <svg
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    style="color: var(--color-body); flex-shrink: 0;"
    aria-hidden="true"
  >
    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
  </svg>

  <p style="margin: 0; font-size: 13px; color: var(--color-body); font-family: var(--font-mono);">
    Your JSON <strong style="color: var(--color-ink);">never leaves your browser.</strong>
    Zero server contact. Ever.
  </p>
</div>
