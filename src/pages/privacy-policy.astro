---
// src/pages/privacy-policy.astro
import Layout from "../layouts/Layout.astro";

const pageTitle = "Privacy Policy | QuietJSON";
const pageDesc = "Privacy Policy for QuietJSON. Learn how we protect your privacy with 100% client-side JSON formatting and zero server-side data collection.";
const canonical = "https://quietjson.com/privacy-policy";
const lastUpdated = "August 2026";
---

<Layout title={pageTitle} description={pageDesc} canonical={canonical}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-4 pb-16">

    <!-- Heading -->
    <div style="margin-bottom: 32px; max-width: 680px;">
      <h1 style="
        font-size: clamp(20px, 4.5vw, 24px);
        font-weight: 600;
        letter-spacing: -0.4px;
        color: var(--color-ink);
        margin: 0 0 8px 0;
        line-height: 1.3;
        word-break: break-word;
      ">
        Privacy Policy
      </h1>
      <p style="font-size: 14px; color: var(--color-mute); margin: 0;">
        Last updated: {lastUpdated}
      </p>
    </div>

    <div style="max-width: 680px; display: flex; flex-direction: column; gap: 32px;">

      <!-- Core Commitment Banner -->
      <section style="
        padding: 18px 20px;
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-md);
        background: var(--color-canvas-soft);
      ">
        <h2 style="font-size: 15px; font-weight: 600; color: var(--color-ink); margin: 0 0 8px 0; display: flex; align-items: center; gap: 8px;">
          <span>🔒</span> Privacy by Design
        </h2>
        <p style="font-size: 13.5px; color: var(--color-body); line-height: 1.7; margin: 0;">
          QuietJSON is engineered from the ground up to operate without sending your data to any remote server. Everything you paste, upload, repair, or convert stays completely inside your local browser.
        </p>
      </section>

      <!-- 1. Zero Data Collection on JSON Content -->
      <section>
        <h2 style="font-size: 17px; font-weight: 600; color: var(--color-ink); margin: 0 0 10px 0;">
          1. Data Processing &amp; Zero Server Collection
        </h2>
        <p style="font-size: 14px; color: var(--color-body); line-height: 1.8; margin: 0 0 10px 0;">
          We do not collect, store, or transmit any JSON data, text snippets, API tokens, or file contents that you enter into QuietJSON.
        </p>
        <p style="font-size: 14px; color: var(--color-body); line-height: 1.8; margin: 0;">
          All formatting, syntax validation, JSON repair algorithms, CSV/YAML conversions, and diff comparisons run purely in client-side JavaScript within your web browser. No network payloads containing your content are ever sent to our servers or third parties.
        </p>
      </section>

      <!-- 2. Local Storage -->
      <section>
        <h2 style="font-size: 17px; font-weight: 600; color: var(--color-ink); margin: 0 0 10px 0;">
          2. Local Storage &amp; Cookies
        </h2>
        <p style="font-size: 14px; color: var(--color-body); line-height: 1.8; margin: 0 0 10px 0;">
          QuietJSON uses your browser's local storage (<code style="font-family: var(--font-mono); font-size: 13px; background: var(--color-canvas-soft); padding: 2px 6px; border-radius: 4px;">localStorage</code>) solely to remember your user interface preferences, such as your chosen theme (Dark Mode or Light Mode).
        </p>
        <p style="font-size: 14px; color: var(--color-body); line-height: 1.8; margin: 0;">
          This setting stays strictly on your device and is never uploaded or linked to your identity.
        </p>
      </section>

      <!-- 3. Future Analytics and Advertising -->
      <section>
        <h2 style="font-size: 17px; font-weight: 600; color: var(--color-ink); margin: 0 0 10px 0;">
          3. Analytics &amp; Advertising
        </h2>
        <p style="font-size: 14px; color: var(--color-body); line-height: 1.8; margin: 0 0 10px 0;">
          To help maintain and improve our free service, QuietJSON may in the future implement privacy-focused website analytics (such as Google Analytics or Plausible) and advertising networks (such as Google AdSense).
        </p>
        <p style="font-size: 14px; color: var(--color-body); line-height: 1.8; margin: 0;">
          These third-party providers may collect non-identifiable technical information such as your browser type, device category, referring URL, and page interaction timestamps via standard cookies. When such services are introduced or updated, this policy and the "Last updated" date will be revised accordingly.
        </p>
      </section>

      <!-- 4. Third-Party Links -->
      <section>
        <h2 style="font-size: 17px; font-weight: 600; color: var(--color-ink); margin: 0 0 10px 0;">
          4. Third-Party Links
        </h2>
        <p style="font-size: 14px; color: var(--color-body); line-height: 1.8; margin: 0;">
          Our website may contain external links to open-source project repositories (such as GitHub, CodeMirror, or JSON documentation). We are not responsible for the privacy practices, policies, or content of these external third-party websites.
        </p>
      </section>

      <!-- 5. Children's Privacy -->
      <section>
        <h2 style="font-size: 17px; font-weight: 600; color: var(--color-ink); margin: 0 0 10px 0;">
          5. Children's Privacy
        </h2>
        <p style="font-size: 14px; color: var(--color-body); line-height: 1.8; margin: 0;">
          QuietJSON is a general-purpose developer tool and is not directed towards children under the age of 13. We do not knowingly collect or solicit personal information from children.
        </p>
      </section>

      <!-- 6. Contact -->
      <section style="
        padding: 20px 22px;
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-md);
        background: var(--color-canvas);
      ">
        <h2 style="font-size: 15px; font-weight: 600; color: var(--color-ink); margin: 0 0 8px 0;">
          Questions or Concerns?
        </h2>
        <p style="font-size: 13.5px; color: var(--color-body); line-height: 1.7; margin: 0 0 10px 0;">
          If you have any questions regarding this Privacy Policy, please contact us:
        </p>
        <a
          href="mailto:hello@quietjson.com"
          style="
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 13.5px;
            font-weight: 500;
            color: var(--color-link);
            text-decoration: none;
          "
        >
          ✉ hello@quietjson.com →
        </a>
      </section>

    </div>
  </div>
</Layout>
