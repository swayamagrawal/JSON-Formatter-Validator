---
// src/pages/404.astro
import Layout from "../layouts/Layout.astro";

const quickTools = [
  { href: "/", label: "JSON Formatter", desc: "Format & validate JSON" },
  { href: "/json-repair", label: "JSON Repair", desc: "Fix broken LLM output" },
  { href: "/json-to-csv", label: "JSON to CSV", desc: "Convert to spreadsheet" },
  { href: "/json-to-yaml", label: "JSON to YAML", desc: "Convert configuration" },
  { href: "/json-diff", label: "JSON Diff", desc: "Compare two JSON objects" },
];
---

<Layout
  title="404 - Page Not Found | QuietJSON"
  description="The page you are looking for does not exist."
  noIndex={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-8 pb-20 flex flex-col items-center justify-center text-center">

    <!-- 404 Visual Glyph -->
    <div style="
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 6px 16px;
      background: var(--color-canvas-soft);
      border: 1px solid var(--color-hairline);
      border-radius: var(--radius-md);
      font-family: var(--font-mono);
      font-size: 16px;
      font-weight: 700;
      color: var(--color-link);
      margin-bottom: 24px;
      letter-spacing: -0.5px;
    ">
      &#123; error: 404 &#125;
    </div>

    <!-- Main Heading -->
    <h1 style="
      font-size: clamp(24px, 5vw, 36px);
      font-weight: 700;
      letter-spacing: -0.8px;
      color: var(--color-ink);
      margin: 0 0 12px 0;
      line-height: 1.25;
    ">
      404 — Page Not Found
    </h1>

    <p style="
      font-size: 15px;
      color: var(--color-body);
      max-width: 480px;
      line-height: 1.65;
      margin: 0 0 28px 0;
    ">
      The page you're looking for might have been moved, renamed, or doesn't exist.
    </p>

    <!-- Primary Action Button -->
    <a
      href="/"
      style="
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        background: var(--color-link);
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        border-radius: var(--radius-md);
        text-decoration: none;
        box-shadow: var(--shadow-1);
        transition: opacity 0.15s, transform 0.15s;
        margin-bottom: 48px;
      "
      class="hover:opacity-90 active:scale-95"
    >
      ← Back to JSON Formatter
    </a>

    <!-- Quick Tools Section -->
    <div style="max-width: 680px; width: 100%; text-align: left;">
      <h2 style="
        font-size: 14px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--color-mute);
        margin: 0 0 14px 0;
        text-align: center;
      ">
        Or explore available tools:
      </h2>

      <div class="error-tools-grid" style="
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 12px;
      ">
        {quickTools.map(tool => (
          <a
            href={tool.href}
            style="
              display: block;
              padding: 14px 16px;
              background: var(--color-canvas);
              border: 1px solid var(--color-hairline);
              border-radius: var(--radius-md);
              text-decoration: none;
              transition: border-color 0.15s, background 0.15s;
            "
            class="error-tool-card"
          >
            <span style="font-size: 14px; font-weight: 600; color: var(--color-ink); display: block; margin-bottom: 2px;">
              {tool.label} →
            </span>
            <span style="font-size: 12.5px; color: var(--color-mute);">
              {tool.desc}
            </span>
          </a>
        ))}
      </div>
    </div>

  </div>

  <style>
    .error-tool-card:hover {
      border-color: var(--color-link) !important;
      background: var(--color-canvas-soft) !important;
    }
  </style>
</Layout>
