---
// src/pages/guides/index.astro
import Layout from "../../layouts/Layout.astro";

const pageTitle = "Developer Guides & JSON Tutorials | QuietJSON";
const pageDesc = "Helpful developer guides on formatting JSON, debugging API payloads, comparing JSON files, and repairing broken AI responses.";
const canonical = "https://quietjson.com/guides";

const guides = [
  {
    title: "How to Compare Two JSON Files: The Complete Guide",
    desc: "Learn why plain text diff tools (like git diff) fail on JSON, how semantic object diffing works, and how to track additions and modifications with JSONPath.",
    href: "/guides/how-to-compare-two-json-files",
    badge: "JSON Diff",
    readTime: "5 min read"
  },
  {
    title: "How to Fix JSON from ChatGPT, Claude & Gemini",
    desc: "Discover the 5 most common JSON errors generated by LLMs (unquoted keys, Python booleans, trailing commas) and how to fix them automatically.",
    href: "/guides/how-to-fix-json-from-chatgpt",
    badge: "AI & LLM",
    readTime: "5 min read"
  },
  {
    title: "JSON Formatting Guide — How to Format JSON Online",
    desc: "A beginner-to-advanced guide on JSON structure, 2-space vs. 4-space indentation, minification, and browser-based formatting security.",
    href: "/guides/json-formatter-guide",
    badge: "Basics",
    readTime: "4 min read"
  }
];

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://quietjson.com" },
    { "@type": "ListItem", "position": 2, "name": "Guides", "item": canonical }
  ]
};
---

<Layout title={pageTitle} description={pageDesc} canonical={canonical}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <div class="max-w-3xl mx-auto px-4 sm:px-6 pt-6 pb-16">
    <nav style="font-size: 13px; color: var(--color-mute); margin-bottom: 20px;">
      <a href="/" style="color: var(--color-link); text-decoration: none;">Home</a>
      <span style="margin: 0 6px;">&#8250;</span>
      <span style="color: var(--color-ink);">Guides</span>
    </nav>

    <h1 style="font-size: clamp(22px, 5vw, 30px); font-weight: 700; letter-spacing: -0.5px; color: var(--color-ink); margin: 0 0 10px 0; line-height: 1.25;">
      Developer Guides &amp; Tutorials
    </h1>
    <p style="font-size: 15px; color: var(--color-body); line-height: 1.7; margin: 0 0 32px 0;">
      Practical tutorials and technical guides to help you format, validate, compare, and fix JSON in your development workflows.
    </p>

    <div style="display: flex; flex-direction: column; gap: 18px;">
      {guides.map((g) => (
        <a
          href={g.href}
          style="display: block; padding: 20px 22px; background: var(--color-canvas); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); text-decoration: none; box-shadow: var(--shadow-1); transition: border-color 0.15s, transform 0.15s;"
        >
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
            <span style="font-size: 11.5px; font-weight: 600; color: var(--color-link); background: var(--color-link-bg-soft, rgba(0,112,243,0.08)); padding: 2px 8px; border-radius: 4px; font-family: var(--font-mono);">
              {g.badge}
            </span>
            <span style="font-size: 12px; color: var(--color-mute);">
              {g.readTime}
            </span>
          </div>
          <h2 style="font-size: 17px; font-weight: 600; color: var(--color-ink); margin: 0 0 8px 0; line-height: 1.4;">
            {g.title}
          </h2>
          <p style="font-size: 13.5px; color: var(--color-body); line-height: 1.6; margin: 0;">
            {g.desc}
          </p>
        </a>
      ))}
    </div>
  </div>
</Layout>
