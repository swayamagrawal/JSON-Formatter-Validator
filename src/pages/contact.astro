---
// src/pages/contact.astro
import Layout from "../layouts/Layout.astro";

const pageTitle = "Contact Us | QuietJSON";
const pageDesc = "Have questions, feedback, or found a bug? Get in touch with the QuietJSON team.";
const canonical = "https://quietjson.com/contact";
---

<Layout title={pageTitle} description={pageDesc} canonical={canonical}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-4 pb-16">

    <!-- Heading -->
    <div style="margin-bottom: 36px; max-width: 680px;">
      <h1 style="
        font-size: clamp(20px, 4.5vw, 24px);
        font-weight: 600;
        letter-spacing: -0.4px;
        color: var(--color-ink);
        margin: 0 0 8px 0;
        line-height: 1.3;
        word-break: break-word;
      ">
        Get in Touch
      </h1>
      <p style="font-size: 15px; color: var(--color-body); margin: 0; line-height: 1.65;">
        Have a question, found a bug, or want to suggest a feature? Reach out anytime.
      </p>
    </div>

    <div style="max-width: 680px; display: flex; flex-direction: column; gap: 24px;">

      <!-- Primary Contact Card -->
      <div style="
        padding: 24px;
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-md);
        background: var(--color-canvas);
        box-shadow: var(--shadow-1);
      ">
        <div style="font-size: 24px; margin-bottom: 12px;">✉️</div>
        <h2 style="font-size: 17px; font-weight: 600; color: var(--color-ink); margin: 0 0 8px 0;">
          Direct Email Support
        </h2>
        <p style="font-size: 14px; color: var(--color-body); line-height: 1.75; margin: 0 0 16px 0;">
          For all general inquiries, bug reports, feature suggestions, or business questions, email us directly:
        </p>
        <a
          href="mailto:hello@quietjson.com"
          style="
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            background: var(--color-canvas-soft);
            border: 1px solid var(--color-hairline);
            border-radius: var(--radius-md);
            color: var(--color-link);
            font-size: 15px;
            font-weight: 600;
            text-decoration: none;
            transition: border-color 0.15s, background 0.15s;
          "
          class="contact-mail-btn"
        >
          <span>hello@quietjson.com</span>
          <span style="font-size: 14px;">↗</span>
        </a>
      </div>

      <!-- Bug Reports & Feedback Grid -->
      <div style="
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
      " class="contact-grid">
        <!-- Bug Reports -->
        <div style="
          padding: 20px;
          border: 1px solid var(--color-hairline);
          border-radius: var(--radius-md);
          background: var(--color-canvas-soft);
        ">
          <h3 style="font-size: 15px; font-weight: 600; color: var(--color-ink); margin: 0 0 6px 0;">
            🐛 Found a Bug?
          </h3>
          <p style="font-size: 13.5px; color: var(--color-body); line-height: 1.6; margin: 0;">
            Please let us know what input caused the error and which browser you are using. We prioritize fixing parser and repair issues immediately.
          </p>
        </div>

        <!-- Feature Requests -->
        <div style="
          padding: 20px;
          border: 1px solid var(--color-hairline);
          border-radius: var(--radius-md);
          background: var(--color-canvas-soft);
        ">
          <h3 style="font-size: 15px; font-weight: 600; color: var(--color-ink); margin: 0 0 6px 0;">
            💡 Feature Requests
          </h3>
          <p style="font-size: 13.5px; color: var(--color-body); line-height: 1.6; margin: 0;">
            Need a new converter format (like JSON to TOML or XML) or an editor setting? Send us your suggestions!
          </p>
        </div>
      </div>

      <!-- Response Time Note -->
      <div style="
        padding: 16px 20px;
        border: 1px solid var(--color-hairline);
        border-radius: var(--radius-md);
        background: var(--color-canvas);
        font-size: 13.5px;
        color: var(--color-mute);
        line-height: 1.6;
      ">
        ⏱️ We usually respond to developer inquiries and bug reports within <strong>24 to 48 hours</strong>.
      </div>

    </div>
  </div>

  <style>
    @media (max-width: 640px) {
      .contact-grid {
        grid-template-columns: 1fr !important;
      }
    }
    .contact-mail-btn:hover {
      border-color: var(--color-link) !important;
      background: var(--color-canvas-soft-2) !important;
    }
  </style>
</Layout>
