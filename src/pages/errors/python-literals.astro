---
// src/pages/errors/python-literals.astro
import Layout from "../../layouts/Layout.astro";

const pageTitle = "Fix: Unexpected token 'True', 'False', or 'None' in JSON | QuietJSON";
const pageDesc = "Why copying Python dictionaries into JSON fails with 'SyntaxError: Unexpected token True/None'. How to fix Python boolean and None literals instantly.";
const canonical = "https://quietjson.com/errors/python-literals/";

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://quietjson.com" },
    { "@type": "ListItem", "position": 2, "name": "Error Reference", "item": "https://quietjson.com/errors/" },
    { "@type": "ListItem", "position": 3, "name": "Python Literals in JSON", "item": canonical }
  ]
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why are True, False, and None invalid in JSON?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "JSON (RFC 8259) is derived from JavaScript object syntax, where boolean literals are strictly lowercase 'true' and 'false', and the empty value is strictly 'null'. Capitalized Python constants like True, False, and None are treated as undefined identifier tokens and cause a SyntaxError."
      }
    },
    {
      "@type": "Question",
      "name": "How do I serialize Python dictionaries directly to valid JSON in Python?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Use Python's built-in json library instead of str() or print(): import json; json_string = json.dumps(my_dict). This automatically converts True to true, False to false, and None to null."
      }
    },
    {
      "@type": "Question",
      "name": "What if Python literals are used as object keys?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In Python, dict keys can be booleans like {True: 1}. In JSON, all object keys MUST be double-quoted strings. Therefore, {True: 1} must be converted to {\"true\": 1} in valid JSON."
      }
    }
  ]
};
---

<Layout title={pageTitle} description={pageDesc} canonical={canonical}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <div style="max-width: 780px; width: 100%; margin: 0 auto; padding: 24px 16px 64px; box-sizing: border-box;">
    <!-- Breadcrumb -->
    <nav style="font-size: 13px; color: var(--color-mute); margin-bottom: 20px;">
      <a href="/" style="color: var(--color-link); text-decoration: none;">Home</a>
      <span style="margin: 0 6px;">&#8250;</span>
      <a href="/errors/" style="color: var(--color-link); text-decoration: none;">Errors</a>
      <span style="margin: 0 6px;">&#8250;</span>
      <span style="color: var(--color-ink);">Python Literals</span>
    </nav>

    <!-- Header -->
    <div style="margin-bottom: 28px;">
      <div style="font-size: 12px; font-weight: 600; color: var(--color-error-deep); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;">
        SyntaxError: Unexpected Identifier
      </div>
      <h1 style="font-size: clamp(22px, 5vw, 30px); font-weight: 700; letter-spacing: -0.5px; color: var(--color-ink); margin: 0 0 10px 0; line-height: 1.25;">
        Fix: Unexpected token 'True', 'False', or 'None' in JSON
      </h1>
      <p style="font-size: 15px; color: var(--color-body); line-height: 1.6; margin: 0;">
        Pasting raw Python dictionaries, Jupyter notebook printouts, or Django logs into a JSON tool or API endpoint triggers syntax errors because Python and JSON use different literal constants.
      </p>
    </div>

    <!-- Error Display Box -->
    <div style="background: var(--color-error-soft); border: 1px solid var(--color-error-hairline); border-radius: var(--radius-md); padding: 16px; margin-bottom: 32px; font-family: var(--font-mono); font-size: 13px; color: var(--color-error-deep); line-height: 1.5;">
      <strong>SyntaxError:</strong> Unexpected token 'T', "&#123;&quot;active&quot;: True...&#125;" is not valid JSON
    </div>

    <!-- Conversion Mapping Table -->
    <section style="margin-bottom: 36px;">
      <h2 style="font-size: 18px; font-weight: 600; color: var(--color-ink); margin: 0 0 14px 0;">
        Python vs. JSON Literal Equivalents
      </h2>
      <div style="overflow-x: auto;">
        <table style="width: 100%; border-collapse: collapse; font-size: 14px; text-align: left;">
          <thead>
            <tr style="border-bottom: 2px solid var(--color-hairline); background: var(--color-canvas-soft);">
              <th style="padding: 10px 14px; font-weight: 600; color: var(--color-ink);">Python Literal (Invalid in JSON)</th>
              <th style="padding: 10px 14px; font-weight: 600; color: var(--color-ink);">JSON Standard (Valid RFC 8259)</th>
              <th style="padding: 10px 14px; font-weight: 600; color: var(--color-ink);">Meaning</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid var(--color-hairline);">
              <td style="padding: 10px 14px; font-family: var(--font-mono); color: var(--color-error-deep);">True</td>
              <td style="padding: 10px 14px; font-family: var(--font-mono); color: #15803d; font-weight: 600;">true</td>
              <td style="padding: 10px 14px; color: var(--color-body);">Boolean truth</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline);">
              <td style="padding: 10px 14px; font-family: var(--font-mono); color: var(--color-error-deep);">False</td>
              <td style="padding: 10px 14px; font-family: var(--font-mono); color: #15803d; font-weight: 600;">false</td>
              <td style="padding: 10px 14px; color: var(--color-body);">Boolean falsehood</td>
            </tr>
            <tr style="border-bottom: 1px solid var(--color-hairline);">
              <td style="padding: 10px 14px; font-family: var(--font-mono); color: var(--color-error-deep);">None</td>
              <td style="padding: 10px 14px; font-family: var(--font-mono); color: #15803d; font-weight: 600;">null</td>
              <td style="padding: 10px 14px; color: var(--color-body);">Empty / null value</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Context Caveat: Key vs Value -->
    <section style="margin-bottom: 36px;">
      <h2 style="font-size: 18px; font-weight: 600; color: var(--color-ink); margin: 0 0 12px 0;">
        Special Case: Python Literals in Object Key Positions
      </h2>
      <p style="font-size: 14px; color: var(--color-body); line-height: 1.75; margin: 0 0 12px 0;">
        In Python, dictionary keys can be booleans: <code style="font-family: var(--font-mono);">&#123;True: "verified"&#125;</code>.
        However, in JSON, <strong>all object keys must be double-quoted strings</strong>.
      </p>
      <div style="background: var(--color-canvas-soft); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); padding: 14px; font-family: var(--font-mono); font-size: 13px; line-height: 1.6;">
        <span style="color: var(--color-mute);"># Python dictionary:</span><br />
        d = &#123; True: "active", None: "unassigned" &#125;<br /><br />
        <span style="color: var(--color-mute);">// Valid JSON equivalent (keys must be double-quoted strings):</span><br />
        &#123; "true": "active", "null": "unassigned" &#125;
      </div>
    </section>

    <!-- Quick Fix Code Example -->
    <section style="margin-bottom: 36px;">
      <h2 style="font-size: 18px; font-weight: 600; color: var(--color-ink); margin: 0 0 12px 0;">
        How to Fix Automatically
      </h2>
      <p style="font-size: 14px; color: var(--color-body); line-height: 1.7; margin: 0 0 12px 0;">
        QuietJSON's Repair engine automatically identifies unquoted Python literals and converts them to lowercase JSON primitives in one click without touching strings that contain the words.
      </p>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
        <div style="background: var(--color-error-soft); border: 1px solid var(--color-error-hairline); border-radius: var(--radius-sm); padding: 14px; font-family: var(--font-mono); font-size: 12.5px; line-height: 1.5;">
          <div style="font-weight: 600; color: var(--color-error-deep); margin-bottom: 6px;">Invalid (Python Dict):</div>
          &#123;<br />
          &nbsp;&nbsp;"verified": True,<br />
          &nbsp;&nbsp;"pending": False,<br />
          &nbsp;&nbsp;"error": None<br />
          &#125;
        </div>

        <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: var(--radius-sm); padding: 14px; font-family: var(--font-mono); font-size: 12.5px; line-height: 1.5;">
          <div style="font-weight: 600; color: #15803d; margin-bottom: 6px;">Valid JSON (RFC 8259):</div>
          &#123;<br />
          &nbsp;&nbsp;"verified": true,<br />
          &nbsp;&nbsp;"pending": false,<br />
          &nbsp;&nbsp;"error": null<br />
          &#125;
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section style="margin-bottom: 40px;">
      <h2 style="font-size: 18px; font-weight: 600; color: var(--color-ink); margin: 0 0 16px 0;">
        Frequently Asked Questions
      </h2>
      <div style="display: flex; flex-direction: column; gap: 16px;">
        {faqLd.mainEntity.map((item) => (
          <div style="border-bottom: 1px solid var(--color-hairline); padding-bottom: 16px;">
            <h3 style="font-size: 15px; font-weight: 600; color: var(--color-ink); margin: 0 0 6px 0;">
              {item.name}
            </h3>
            <p style="font-size: 14px; color: var(--color-body); line-height: 1.7; margin: 0;">
              {item.acceptedAnswer.text}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- QuietJSON CTA -->
    <div style="padding: 20px; background: var(--color-canvas-soft); border: 1px solid var(--color-hairline); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
      <div>
        <h4 style="font-size: 15px; font-weight: 600; color: var(--color-ink); margin: 0 0 4px 0;">
          Auto-convert Python literals to valid JSON
        </h4>
        <p style="font-size: 13px; color: var(--color-body); margin: 0;">
          Use QuietJSON Repair to replace True, False, and None in one click.
        </p>
      </div>
      <a href="/json-repair/" style="padding: 7px 16px; font-size: 13px; font-weight: 500; background: var(--color-ink); color: var(--color-canvas); border-radius: var(--radius-sm); text-decoration: none;">
        Repair JSON Now &#8594;
      </a>
    </div>

  </div>
</Layout>
